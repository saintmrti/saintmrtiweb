---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <p set:html={it.a} />
    </details>
  ))}
</div>

<style>
  .faq { margin-top: 36px; border-bottom: 1px solid rgba(244, 240, 255, 0.14); }
  details { border-top: 1px solid rgba(244, 240, 255, 0.14); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 0; font: 600 var(--fs-lead)/1.3 var(--font-barlow); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ""; flex: none; width: 12px; height: 12px; border-right: 3px solid var(--color-aprender); border-bottom: 3px solid var(--color-aprender); transform: rotate(45deg); transition: transform 0.2s; margin-bottom: 4px; }
  details[open] summary::after { transform: rotate(-135deg); margin-bottom: -4px; }
  details p { margin: 0 0 22px; max-width: 62ch; color: var(--color-ink-2); }
  details p :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
