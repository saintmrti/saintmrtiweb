---
import { Image } from 'astro:assets';
import infinito from '../assets/brand/infinito.png';

interface Props { hayApps?: boolean }
const { hayApps = true } = Astro.props;
const links = [
  { href: '/#clase', texto: 'Clases' },
  { href: '/#servicios', texto: 'Servicios' },
  ...(hayApps ? [{ href: '/#apps', texto: 'Apps' }] : []),
  { href: '/#sobre-mi', texto: 'Sobre mí' },
];
---
<header class="nav">
  <div class="nav-in">
    <a class="brand" href="/" aria-label="saintmrti, inicio">
      <Image src={infinito} alt="" width={34} height={34} class="mark" />
      saintmrti
    </a>
    <nav class="links" aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.texto}</a>)}
    </nav>
    <a class="navbtn" href="/#lista">Lista de espera</a>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: var(--color-ground); border-bottom: 1px solid rgba(244, 240, 255, 0.14); }
  .nav-in { max-width: 1440px; margin: 0 auto; height: 76px; padding-inline: clamp(16px, 4vw, 56px); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; font: 600 20px var(--font-barlow); letter-spacing: 0.01em; text-decoration: none; }
  .brand :global(.mark) { width: 34px; height: 34px; }
  .links { display: none; gap: 28px; font: 500 16px var(--font-barlow); }
  .links a { text-decoration: none; color: var(--color-ink-2); padding: 6px 0; border-bottom: 2px solid transparent; transition: color 0.2s, border-color 0.2s; }
  .links a:hover { color: #fff; border-color: var(--color-aprender); }
  .navbtn { font: 600 15px var(--font-barlow); text-decoration: none; padding: 9px 16px; border: 2px solid rgba(244, 240, 255, 0.85); border-radius: 8px; transition: background 0.2s; white-space: nowrap; }
  .navbtn:hover { background: rgba(244, 240, 255, 0.1); }
  @media (min-width: 900px) { .links { display: flex; } }
</style>
