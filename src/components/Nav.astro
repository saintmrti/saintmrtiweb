---
import { Image } from 'astro:assets';
import infinito from '../assets/brand/infinito.png';

interface Props { hayApps?: boolean }
const { hayApps = true } = Astro.props;
const links = [
  { href: '/#clase', texto: 'Clases' },
  { href: '/#servicios', texto: 'Servicios' },
  ...(hayApps ? [{ href: '/#apps', texto: 'Apps' }] : []),
  { href: '/#sobre-mi', texto: 'Sobre mí' },
];
---
<header class="nav" data-menu data-abierto="false">
  <div class="nav-in">
    <a class="brand" href="/" aria-label="saintmrti, inicio">
      <Image src={infinito} alt="" width={34} height={34} class="mark" />
      saintmrti
    </a>
    <nav class="links" aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.texto}</a>)}
    </nav>
    <a class="navbtn" href="/#lista">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
      Lista de espera
    </a>
    <button class="menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil" data-abrir>
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>

  <div class="scrim" data-cerrar aria-hidden="true"></div>
  <div class="drawer" id="menu-movil" role="dialog" aria-modal="true" aria-label="Menú">
    <div class="drawer-top">
      <a class="brand" href="/" aria-label="saintmrti, inicio">
        <Image src={infinito} alt="" width={34} height={34} class="mark" />
        saintmrti
      </a>
      <button class="menu-btn cerrar" type="button" aria-label="Cerrar menú" data-cerrar>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
      </button>
    </div>
    <nav aria-label="Principal">
      <ul class="drawer-links">
        {links.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-m btn-full drawer-cta" href="/#lista">Lista de espera</a>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: var(--color-ground); border-bottom: 1px solid rgba(244, 240, 255, 0.14); }
  /* Arriba del todo la barra es transparente; al hacer scroll se vuelve sólida para que el contenido no se mezcle con ella.
     Sin JavaScript se queda sólida. La animación se activa después de la primera lectura, para que no parpadee al cargar. */
  .nav[data-listo] { transition: background-color 0.25s ease, border-color 0.25s ease; }
  .nav[data-arriba="true"] { background: transparent; border-bottom-color: transparent; }
  .nav-in { max-width: 1440px; margin: 0 auto; height: var(--nav-h); padding-inline: clamp(16px, 4vw, 56px); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; font: 600 var(--fs-lead) var(--font-barlow); letter-spacing: 0.01em; text-decoration: none; }
  .brand :global(.mark) { width: 34px; height: 34px; }
  .links { display: none; gap: 28px; font: 500 var(--fs-nav) var(--font-barlow); }
  .links a { text-decoration: none; color: var(--color-ink-2); padding: 6px 0; border-bottom: 2px solid transparent; transition: color 0.2s, border-color 0.2s; }
  .links a:hover { color: #fff; border-color: var(--color-aprender); }
  /* Pastilla violeta con ícono, como el botón "Regístrate" del portafolio. */
  .navbtn { display: none; align-items: center; gap: 8px; font: 600 var(--fs-nav-button) var(--font-barlow); text-decoration: none; padding: 8px 18px 8px 14px; border: 1.5px solid var(--color-violeta); border-radius: 999px; background: var(--color-violeta-fondo); color: var(--color-porcelain); transition: background 0.2s, border-color 0.2s, color 0.2s; white-space: nowrap; }
  .navbtn svg { flex: none; }
  /* Se llena de rosa, como el botón principal. Con cursor, al pasar encima; en pantallas táctiles no hay hover, así que se llena mientras se presiona. */
  .navbtn:active { background: var(--color-aprender); border-color: var(--color-aprender); color: var(--color-ground); }
  @media (hover: hover) {
    .navbtn:hover { background: var(--color-aprender); border-color: var(--color-aprender); color: var(--color-ground); }
  }

  /* Celular: botón de hamburguesa y menú que entra por la derecha. */
  /* Ícono sin borde. El área táctil sigue siendo de 44px; el margen negativo alinea el trazo con el borde del contenido. */
  .menu-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-right: -15px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--color-porcelain); cursor: pointer; transition: background 0.2s; }
  .menu-btn svg { width: 20px; height: 20px; }
  .menu-btn:active { background: rgba(244, 240, 255, 0.1); }
  .scrim { position: fixed; inset: 0; z-index: 60; background: rgba(5, 4, 24, 0.64); opacity: 0; pointer-events: none; touch-action: none; transition: opacity 0.3s ease; }
  .drawer { position: fixed; top: 0; right: 0; bottom: 0; z-index: 61; width: min(86vw, 360px); display: flex; flex-direction: column; padding: 0 20px 28px; background: var(--color-ground); border-left: 1px solid rgba(244, 240, 255, 0.14); overflow-y: auto; overscroll-behavior: contain; transform: translateX(100%); visibility: hidden; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.3s; }
  .nav[data-abierto="true"] .scrim { opacity: 1; pointer-events: auto; }
  .nav[data-abierto="true"] .drawer { transform: none; visibility: visible; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  .drawer-top { flex: none; display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); }
  .drawer-links { list-style: none; margin: 8px 0 0; padding: 0; }
  .drawer-links a { display: flex; align-items: center; min-height: 58px; border-bottom: 1px solid rgba(244, 240, 255, 0.14); font: 500 var(--fs-lead)/1.2 var(--font-barlow); color: var(--color-ink-2); text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .drawer-links a:active, .drawer-links a:focus-visible { color: #fff; border-color: var(--color-aprender); }
  .drawer-cta { margin-top: 28px; flex: none; }
  :global(html.menu-abierto) { overflow: hidden; }

  @media (min-width: 900px) {
    .links { display: flex; }
    .navbtn { display: inline-flex; }
    .menu-btn, .scrim, .drawer { display: none; }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-menu]');
  const boton = raiz?.querySelector<HTMLButtonElement>('[data-abrir]');
  const panel = raiz?.querySelector<HTMLElement>('#menu-movil');
  const cerrarBtn = panel?.querySelector<HTMLButtonElement>('button.cerrar');

  if (raiz && boton && panel && cerrarBtn) {
    const html = document.documentElement;
    const escritorio = window.matchMedia('(min-width: 900px)');
    // Mientras el menú está abierto, lo demás queda inerte: sin foco, sin lector de pantalla y sin clics.
    const detras = () => [raiz.querySelector<HTMLElement>('.nav-in'), document.querySelector<HTMLElement>('main'), document.querySelector<HTMLElement>('footer'), document.querySelector<HTMLElement>('.skip')].filter((el): el is HTMLElement => el !== null);
    const abierto = () => raiz.dataset.abierto === 'true';

    const abrir = () => {
      if (abierto() || escritorio.matches) return;
      raiz.dataset.abierto = 'true';
      boton.setAttribute('aria-expanded', 'true');
      html.classList.add('menu-abierto');
      detras().forEach((el) => el.setAttribute('inert', ''));
      cerrarBtn.focus();
    };
    const cerrar = (devolverFoco = true) => {
      if (!abierto()) return;
      raiz.dataset.abierto = 'false';
      boton.setAttribute('aria-expanded', 'false');
      html.classList.remove('menu-abierto');
      detras().forEach((el) => el.removeAttribute('inert'));
      if (devolverFoco) boton.focus();
    };

    boton.addEventListener('click', abrir);
    // Cierra con la X y al tocar fuera del menú (el fondo oscuro).
    raiz.querySelectorAll('[data-cerrar]').forEach((el) => el.addEventListener('click', () => cerrar()));
    // Cierra al elegir un enlace; la navegación sigue su curso.
    panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) cerrar(false); });

    document.addEventListener('keydown', (e) => {
      if (!abierto()) return;
      if (e.key === 'Escape') { e.preventDefault(); cerrar(); return; }
      if (e.key !== 'Tab') return;
      // El foco da la vuelta dentro del menú.
      const f = Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
      const primero = f[0], ultimo = f[f.length - 1];
      if (e.shiftKey && document.activeElement === primero) { e.preventDefault(); ultimo.focus(); }
      else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primero.focus(); }
    });

    // Si la ventana pasa a escritorio con el menú abierto, se cierra sin más.
    escritorio.addEventListener('change', () => { if (escritorio.matches) cerrar(false); });
  }

  // Barra transparente arriba del todo y sólida al hacer scroll.
  if (raiz) {
    const actualizar = () => { raiz.dataset.arriba = String(window.scrollY <= 8); };
    actualizar();
    requestAnimationFrame(() => requestAnimationFrame(() => { raiz.dataset.listo = 'true'; }));
    let esperando = false;
    window.addEventListener('scroll', () => {
      if (esperando) return;
      esperando = true;
      requestAnimationFrame(() => { esperando = false; actualizar(); });
    }, { passive: true });
    window.addEventListener('pageshow', actualizar);
  }
</script>
