---
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'testimonios'>[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <ul class="testimonios">
    {items.map((t) => (
      <li>
        {t.data.muestra && <span class="tag tag-a muestra">Ejemplo</span>}
        <blockquote>{t.data.texto}</blockquote>
        <p class="quien"><b>{t.data.nombre}</b>{t.data.rol && <span> · {t.data.rol}</span>}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .testimonios { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 28px; }
  li { display: grid; gap: 14px; align-content: start; padding-top: 22px; border-top: 2px solid rgba(244, 240, 255, 0.85); }
  .muestra { justify-self: start; }
  blockquote { margin: 0; font: 500 22px/1.35 var(--font-barlow); text-wrap: pretty; }
  .quien { margin: 0; color: var(--color-ink-2); font-size: 16px; }
  .quien b { color: var(--color-porcelain); }
  @media (min-width: 900px) { .testimonios { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; } }
</style>
