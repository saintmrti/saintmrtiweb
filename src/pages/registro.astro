---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
const src = `${site.formularios.registro}?embedded=true`;
---
<Layout title="Aprende a usar IA para profesionales · saintmrti" description="Pide clases personalizadas en línea sobre inteligencia artificial, dictadas por un programador. No necesitas conocimientos técnicos previos.">
  <section class="wrap seccion" style="--linea: var(--color-aprender)">
    <h1 class="h2">Aprende a usar IA para profesionales</h1>
    <p class="lead">Completa el formulario y obtén clases personalizadas en línea sobre inteligencia artificial, dictadas por un programador. No necesitas conocimientos técnicos previos.</p>
    <div class="marco">
      <iframe src={src} title="Formulario de clases personalizadas de IA" loading="lazy">Cargando…</iframe>
    </div>
    <p class="alt">¿No se ve el formulario? <a href={site.formularios.registro} target="_blank" rel="noopener noreferrer">Ábrelo en otra pestaña</a>.</p>
  </section>
</Layout>

<style>
  .marco { margin-top: 36px; max-width: 760px; border: 2px solid rgba(244, 240, 255, 0.85); border-radius: 12px; overflow: hidden; background: #0e0c31; }
  iframe { display: block; width: 100%; height: 1320px; border: 0; }
  .alt { margin-top: 18px; color: var(--color-ink-2); }
  .alt a { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 640px) { iframe { height: 1148px; } }
</style>
