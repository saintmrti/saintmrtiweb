---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Planes from '../components/Planes.astro';
import Faq from '../components/Faq.astro';
import infinito from '../assets/brand/infinito.png';
import { whatsappUrl } from '../config/site';
import { faq } from '../config/faq';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const preguntas = faq.filter((f) => /servicios|proyecto|datos/i.test(f.q));
---
<Layout title="Servicios de Saint Technology · saintmrti" description="Landing web, app web escalable y automatización con IA para PyMEs mexicanas, profesionales independientes y startups. Cotiza por WhatsApp.">
  <section class="wrap seccion" style="--linea: var(--color-construir)">
    <div class="lockup">
      <Image src={infinito} alt="" width={64} height={64} class="lockup-mark" />
      <div><span class="slab">SAINT</span><span class="tech">TECHNOLOGY</span></div>
    </div>
    <h1 class="h2">Desarrollo de productos web y automatización con IA</h1>
    <p class="lead">Para PyMEs mexicanas, profesionales independientes y startups. Cada proyecto se cotiza según lo que necesitas: escríbeme por WhatsApp y te respondo con una propuesta.</p>
    <Planes servicios={servicios} />
    <p class="proceso">Cada plan incluye 3 videollamadas (para definir lo que necesitas, revisar avances a mitad del camino y presentar el resultado final) y atención personalizada por WhatsApp.</p>
    <p class="cta"><a class="btn btn-b" href={whatsappUrl('Hola Saint, quiero cotizar un proyecto con Saint Technology.')} target="_blank" rel="noopener noreferrer">Cotiza por WhatsApp</a></p>
  </section>
  <section class="banda seccion" style="--linea: var(--color-construir)">
    <div class="wrap">
      <div class="faq-wrap">
        <h2 class="h2">Preguntas frecuentes</h2>
        <Faq items={preguntas} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .lockup { display: flex; align-items: center; gap: 16px; margin-bottom: 36px; }
  .lockup :global(.lockup-mark) { width: 64px; height: 64px; }
  .slab { display: block; font: 700 34px/1 var(--font-zilla-slab); letter-spacing: 0.14em; }
  .tech { display: block; margin-top: 6px; font: 500 14px var(--font-barlow); letter-spacing: 0.42em; color: var(--color-lilac); }
  .proceso { margin-top: 32px; max-width: 62ch; color: var(--color-ink-2); }
  .cta { margin-top: 28px; }
  .cta .btn { width: 100%; }
  .faq-wrap { max-width: 900px; }
  @media (min-width: 640px) { .cta .btn { width: auto; } }
</style>
