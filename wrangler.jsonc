{
  "$schema": "node_modules/wrangler/config-schema.json",
  // saintmrti.com es un sitio estático: Cloudflare Workers sirve los archivos de `dist`, que genera `pnpm build`.
  // El nombre debe ser idéntico al del proyecto en el panel de Cloudflare (Workers & Pages); si no, el build falla.
  "name": "saintmrtiweb",
  "compatibility_date": "2026-11-08",
  // El sitio vive solo en saintmrti.com, conectado como dominio propio desde el panel de Cloudflare.
  // Wrangler no toca ese dominio porque aquí no hay "routes". Se apagan la dirección temporal
  // (*.workers.dev) y las de vista previa para que el sitio no exista también en otra dirección.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Una ruta que no existe muestra la página 404 del sitio, con estado 404.
    "not_found_handling": "404-page"
  }
}
